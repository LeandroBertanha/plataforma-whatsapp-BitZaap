# Domínio público apontado para o IP da VM Oracle.
EVOLUTION_DOMAIN=evolution.seudominio.com.br

# URL pública da interface BitZaap, utilizada somente na política CORS.
BITZAAP_PUBLIC_URL=https://plataforma-whatsapp-conectado-clone-56e50.goskip.app

# A tag latest acompanha o canal oficial. Fixe uma versão antes de atualizações controladas.
EVOLUTION_IMAGE=evoapicloud/evolution-api:latest

# Gere valores diferentes, longos e aleatórios para cada segredo abaixo.
EVOLUTION_API_KEY=substitua_por_uma_chave_aleatoria_com_64_caracteres
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=substitua_por_uma_senha_aleatoria_com_32_caracteres
REDIS_PASSWORD=substitua_por_uma_senha_aleatoria_com_32_caracteres

# Necessário somente no modo local gratuito com ngrok.
NGROK_DOMAIN=seu-dominio-gratuito.ngrok-free.app
NGROK_AUTHTOKEN=substitua_pelo_token_da_sua_conta_ngrok
